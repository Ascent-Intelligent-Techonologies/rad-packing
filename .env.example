# ── Database (Prisma Postgres) ───────────────────────────────────────────
# Added automatically on Vercel by the Prisma Postgres integration.
# Locally: run `npm run db:dev` and use the URL it prints.
DATABASE_URL=

# ── CRM back office at /admin ────────────────────────────────────────────
# The first sign-in with these credentials creates the Administrator account
# (only while the user table is empty). Change the password afterwards in the CRM.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional: email alerts for new website enquiries (Resend) ────────────
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
